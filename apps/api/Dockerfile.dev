FROM node:24-alpine

WORKDIR /app

# Copy root manifests and workspace package definitions for npm workspaces
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# Clean install all dependencies based on root package-lock.json
RUN npm ci

# Copy API application source and configuration
COPY apps/api ./apps/api

EXPOSE 5000

CMD ["npm", "run", "dev", "-w", "apps/api"]
